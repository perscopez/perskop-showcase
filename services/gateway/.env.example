# Perskop gateway configuration. Copy to .env and replace every placeholder.
# Only PERSKOP_API_TOKEN is required; everything else enables optional features.

PORT=8787
# HOST defaults to 0.0.0.0 (needed inside Docker). Use 127.0.0.1 for local dev.
# HOST=127.0.0.1
DATA_DIR=./data
PERSKOP_API_TOKEN=change-me-to-a-long-random-token

# Agent execution. Keep false unless this is a single-user host you trust.
PERSKOP_FULL_ACCESS=false
PERSKOP_NODE_ID=mac
DEFAULT_PROVIDER=codex
CODEX_CMD=codex
CURSOR_CMD=cursor-agent
OPENCODE_CMD=opencode
AGY_CMD=agy
# PERSKOP_MAC_PROVIDER_ORDER=codex,cursor,opencode,direct_model
# PERSKOP_VPS_PROVIDER_ORDER=direct_model,codex
# PERSKOP_PROVIDER_MAX_ATTEMPTS=3

# OpenAI-compatible model endpoint used by the direct_model provider.
# PERSKOP_LLM_PROXY_URL=http://localhost:11434/v1
# PERSKOP_LLM_PROXY_SECRET=change-me-proxy-secret
# PERSKOP_LLM_TIMEOUT_MS=60000

# Sandbox executor (see services/sandbox-executor).
# PERSKOP_EXECUTOR_URL=http://localhost:18788
# PERSKOP_EXECUTOR_TOKEN=change-me-executor-token

# Telegram bot. An empty allowlist blocks everyone.
# TELEGRAM_BOT_TOKEN=000000000:replace-me
# TELEGRAM_ALLOWED_USER_IDS=111111111
# TELEGRAM_NOTIFY_CHAT_ID=111111111

# IMAP mail (use an app password, never your main password).
# EMAIL_ADDRESS=demo@example.com
# EMAIL_PASSWORD=replace-me
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Connectors (Google OAuth for Gmail / Calendar). The master key is a
# base64-encoded 32-byte key that encrypts stored connector tokens.
# PERSKOP_CONNECTOR_MASTER_KEY=replace-with-base64-32-byte-key
# GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=replace-me
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/calendar/connectors/google/oauth/callback

# Scheduled briefs
CRON_EMAIL_ENABLED=false
CRON_MORNING_BRIEF=0 8 * * *
CRON_CALENDAR_BRIEF_HOURS=13,22
CRON_TZ=Europe/Istanbul

# Voice notes (speech-to-text)
VOICE_ENABLED=false
VOICE_STT_PROVIDER=openai
# OPENAI_API_KEY=replace-me
