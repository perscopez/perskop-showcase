{
  "name": "@perskop/gateway",
  "description": "perskop gateway: Fastify API, provider router, memory, connectors and Telegram bot",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
