{
  "name": "@perskop/desktop",
  "description": "Electron + React chat client for the perskop gateway",
  "productName": "perskop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5175\" \"wait-on http://127.0.0.1:5175 && cross-env PERSKOP_DEV_SERVER=http://127.0.0.1:5175 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "tailwindcss": "^4.1.4",
    "vite": "^6.2.5",
    "wait-on": "^8.0.3"
  }
}
