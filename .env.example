# Variables read by docker-compose.perskop.yml (copy to .env next to it).
# All values below are placeholders.
PERSKOP_EXECUTOR_TOKEN=change-me-executor-token
PERSKOP_LLM_PROXY_URL=http://localhost:11434/v1
PERSKOP_LLM_PROXY_SECRET=change-me-proxy-secret
PERSKOP_FULL_ACCESS=false
PERSKOP_CREDENTIAL_ROOT=/srv/perskop/credentials
PERSKOP_WORKSPACE_HOST_PATH=/srv/perskop/workspace-staging
PERSKOP_REPOSITORY_HOST_PATH=/srv/perskop/repositories/perskop.git
